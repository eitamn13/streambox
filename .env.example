# TMDB API Key - Get yours at https://www.themoviedb.org/settings/api
VITE_TMDB_API_KEY=your_tmdb_api_key_here

# StreamBox Backend API (your VPS)
# Set this to use the new self-hosted backend instead of Supabase
VITE_API_URL=https://138.197.176.208

# Supabase (Optional - only if NOT using VITE_API_URL)
# Get yours at https://supabase.com
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key_here

# Stripe (Required for subscriptions)
VITE_STRIPE_PRICE_ID=price_your_stripe_price_id

# Note: Debrid API keys can be entered by users in the app UI
# and stored in their browser's localStorage (self-hosted mode).
# For SaaS mode, set ADMIN_RD_API_KEY on the server.
