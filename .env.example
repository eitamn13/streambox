# TMDB API Key - Get yours at https://www.themoviedb.org/settings/api
VITE_TMDB_API_KEY=your_tmdb_api_key_here

# Supabase (Optional - for cloud auth)
# Get yours at https://supabase.com
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key_here

# Note: Debrid API keys are entered by users in the app UI
# and stored in their browser's localStorage.
# No server-side keys are needed.
